# ==============================================================================
# ELIGIBLE CRM BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ==============================================================================
# FIREBASE REALTIME DATABASE CONFIGURATION
# ==============================================================================
# Path to Firebase Service Account JSON file (downloaded from Firebase Console)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json

# Firebase Realtime Database URL (format: https://<project-id>-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=https://eligiblecrmdatabase-default-rtdb.firebaseio.com

# Realtime Database Paths
FIREBASE_LEADS_PATH=leads
FIREBASE_CAMPAIGNS_PATH=campaigns
FIREBASE_LOGS_PATH=webhook_logs

# ==============================================================================
# META MARKETING & GRAPH API CONFIGURATION
# ==============================================================================
# Meta Graph API Version (e.g., v21.0 or v22.0)
META_API_VERSION=v21.0

# Meta App Credentials (from developers.facebook.com)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Meta User / System User Long-Lived Access Token (with ads_management, leads_retrieval, pages_manage_ads, pages_read_engagement)
META_ACCESS_TOKEN=your_meta_system_user_or_page_access_token

# Meta Ad Account ID (format: act_1234567890 or just 1234567890)
META_AD_ACCOUNT_ID=act_your_ad_account_id

# Meta Facebook Page ID (associated with lead forms)
META_PAGE_ID=your_facebook_page_id

# Meta Webhook Verification Token (any secret string you choose for webhook subscription verification)
META_WEBHOOK_VERIFY_TOKEN=eligible_crm_secure_verify_token_2026
